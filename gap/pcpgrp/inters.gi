#############################################################################
##
#W  grpint.gi                  Polycyc                           Bettina Eick
##

# Based on ReduceExpoPara, but with IsOne instead of IsBool, and adapted to
# the NormalIntersection algorithm
# Returns the positions changed in ind and indd, and in gen.
BindGlobal( "ReduceExpoParaInt", function( ind, indd, gen, rel, pows, ppows )
    local n, changed, cg, i, j, c, g, a, b, q;

    n := Length(rel);
    changed := [];
    cg := [];
    for i in [1..Length(ind)] do
        if i <= n then
            c := i;
            g := ind[i];
        else
            c := i-n;
            g := indd[i];
        fi;
        if not IsOne(g) and rel[c] = 0 then
            b := LeadingExponent(g);
            for j in [1..i-1] do
                if not IsOne(ind[j]) or not IsOne(indd[j]) then
                    if i <= n then
                        a := Exponents(ind[j])[c];
                    else
                        a := Exponents(indd[j])[c];
                    fi;
                    q := QuoInt(a,b);
                    if q <> 0 then
                        ind[j] := ind[j]*IgsNegativePower(ind, pows, i, q);
                        indd[j] := indd[j]*IgsNegativePower(indd, ppows, i, q);
                        AddSet(changed, j);
                    fi;
                fi;
            od;
            for j in [1..Length(gen)] do
                if i <= n then
                    a := Exponents(gen[j][1])[c];
                else
                    a := Exponents(gen[j][2])[c];
                fi;
                q := QuoInt(a,b);
                if q <> 0 then
                    gen[j][1] := gen[j][1]*IgsNegativePower(ind, pows, i, q);
                    gen[j][2] := gen[j][2]*IgsNegativePower(indd, ppows, i, q);
                    AddSet(cg, j);
                fi;
            od;
        fi;
    od;
    return [changed, cg];
end );

#############################################################################
##
#F NormalIntersection( N, U ) . . . . . . . . . . . . . . . . . . .  U \cap N
##
## The core idea here is that the intersection U \cap N equals the kernel of
## the natural homomorphism \phi : U \to UN/N ; see also section 8.8.1 of
## the "Handbook of computational group theory".
## So we can apply the methods for computing kernels of homomorphisms, but we
## need the group UN for this as well, at least implicitly.
##
## The resulting algorithm is quite similar to the Zassenhaus algorithm for
## simultaneously computing the intersection and sum of two vector spaces.
InstallMethod( NormalIntersection, "for pcp groups",
               IsIdenticalObj, [IsPcpGroup, IsPcpGroup],
function( N, U )
    local coll, rels, igsN, igsU, n, s, todo, I, id, ls, rs, g, h, k, d,
          al, ar, e, tm, pairs, changed, j, lo, hi, loDep, hiDep, value,
          depth, c, inf, val, oldc, reduced, chg, i, sub, lpows, rpows;

    # get information
    coll := Collector( N );
    rels := RelativeOrders( coll );
    inf := 0 in rels;

    igsN := Cgs( N );
    igsU := Cgs( U );
    n    := NumberOfGenerators( coll );

    # if N or U is trivial
    if Length( igsN ) = 0 then
        return N;
    elif Length( igsU ) = 0 then
        return U;
    fi;

    # if N or U equals the ambient group
    if Length(igsN) = n and ForAll(igsN, x -> LeadingExponent(x) = 1) then
        return U;
    elif Length(igsU) = n and ForAll(igsU, x -> LeadingExponent(x) = 1) then
        return N;
    fi;

    # if N is a tail, we can read off the result directly
    s := Depth( igsN[1] );
    if Length( igsN ) = n-s+1 and
       ForAll( igsN, x -> LeadingExponent(x) = 1 ) then
        I := Filtered( igsU, x -> Depth(x) >= s );
        return SubgroupByIgs( N, I );
    fi;

    # if U is contained in N or vice versa
    if ForAll(igsU, g -> g in N) then
        return U;
    elif ForAll(igsN, g -> g in U) then
        return N;
    fi;

    # Igs of subgroup generated by (u,u)'s and (n,1)'s in G x G
    # rows (1,u) then give the intersection N ∩ U

    # set up; lpows[d] and rpows[d] cache negative powers of ls[d] and rs[d]
    id := One(N);
    ls := ListWithIdenticalEntries(2*n, id);
    rs := ListWithIdenticalEntries(2*n, id);
    lpows := [];
    rpows := [];
    c  := 2*n+1;

    for g in igsU do
        d := Depth( g );
        ls[d] := g;
        rs[d] := g;
    od;

    # insert N
    todo := List(igsN, g -> [g, id]);

    # depth in G x G
    depth := function(pair)
        if pair[1] <> id then return Depth(pair[1]); fi;
        return n + Depth(pair[2]);
    end;

    # optimisation similar to AddToIgs
    value := function(pair)
        if pair[1] <> id then
            return [2*n-Depth(pair[1]), AbsInt(LeadingExponent(pair[1]))];
        elif pair[2] <> id then
            return [n-Depth(pair[2]), AbsInt(LeadingExponent(pair[2]))];
        else
            return [-1, 0];
        fi;
    end;
    val := List(todo, value);

    # loop over to-do list until it is empty
    while not IsEmpty(todo) and c > 1 do
        j := PositionMinimum(val);
        tm := Remove(todo, j);
        Remove(val, j);
        al := tm[1];
        ar := tm[2];
        changed := [];

        # shift the pair into ls and rs
        while al <> id or ar <> id do
            if al <> id then
                d  := Depth( al );
                g := al;
                h := ls[d];
            else
                d := n + Depth(ar);
                g := ar;
                h := rs[d];
            fi;
            if d >= c then break; fi;

            if h = id then
                e := NormingExponent(g);
                ls[d] := al ^ e;
                rs[d] := ar ^ e;
                Unbind(lpows[d]);
                Unbind(rpows[d]);
                AddSet(changed, d);
                if d <= n then
                    h := ls[d];
                else
                    h := rs[d];
                fi;
            fi;

            if al = ls[d] and ar = rs[d] then
                al := id;
                ar := id;
            elif LeadingExponent(g) mod LeadingExponent(h) = 0 then
                s := d;
                if s > n then s := s-n; fi;
                e := SmallestResidue(LeadingExponent(g) / LeadingExponent(h),
                                     rels[s]);
                if e = 1 and al = ls[d] then
                    al := id;
                elif ls[d] <> id then
                    al := al * IgsNegativePower(ls, lpows, d, e);
                fi;
                if e = 1 and ar = rs[d] then
                    ar := id;
                elif rs[d] <> id then
                    ar := ar * IgsNegativePower(rs, rpows, d, e);
                fi;
            elif d <= n then
                pairs := GcdPcpPara( ls[d], al, rs[d], ar );
                ls[d] := pairs[1];
                al := pairs[2];
                rs[d] := pairs[3];
                ar := pairs[4];
                Unbind(lpows[d]);
                Unbind(rpows[d]);
                AddSet(changed, d);
            else
                pairs := GcdPcp(rs[d], ar);
                rs[d] := pairs[1];
                ar := pairs[2];
                Unbind(rpows[d]);
                AddSet(changed, d);
            fi;
        od;

        # ls and rs unchanged, so skip adjustment, powers and commutators
        if IsEmpty(changed) then
            continue;
        fi;

        # adjust
        oldc := c;
        while c > 1 do
            if c-1 <= n then
                g := ls[c-1];
            else
                g := rs[c-1];
            fi;
            if g = id or LeadingExponent(g) <> 1 then
                break;
            fi;
            c := c-1;
        od;
        chg := [];
        if inf then
            reduced := ReduceExpoParaInt(ls, rs, todo, rels, lpows, rpows);
            for i in reduced[1] do
                Unbind(lpows[i]);
                Unbind(rpows[i]);
            od;
            UniteSet(changed, reduced[1]);
            chg := reduced[2];
            for i in chg do
                if depth(todo[i]) < c then val[i] := value(todo[i]); fi;
            od;
        fi;

        # add powers and commutators
        for d in changed do
            # skip infinite factors and powers in the tail
            if d < c-1 then
                if d <= n then
                    g := ls[d];
                else
                    g := rs[d];
                fi;
                e := RelativeOrderPcp(g);
                if e > 0 then
                    tm := [ls[d] ^ e, rs[d] ^ e];
                    if depth(tm) < c then
                        Add(todo, tm);
                        Add(val, value(tm));
                    fi;
                fi;
            fi;
            for j in [1..2*n] do
                # skip repeated or trivial commutators and those in the tail
                if j = d or (j < d and j in changed) or
                   Minimum(d, j) >= c-1 or
                   (ls[j] = id and rs[j] = id) then continue; fi;
                # don't calculate Comm if elements are known to commute
                lo := Minimum(d, j);
                hi := Maximum(d, j);
                # for j > n, ls[j] = id; for j <= n either id or depth j
                # PC_COMMUTE[i] = j means that a_i .. a_n commute with
                # a_{j+1} .. a_n
                if ls[hi] = id or ls[lo] = id or coll![PC_COMMUTE][lo] < hi then
                    al := id;
                else
                    al := Comm(ls[hi], ls[lo]);
                fi;
                if rs[hi] = id or rs[lo] = id then
                    ar := id;
                else
                    loDep := Minimum(Depth(rs[hi]), Depth(rs[lo]));
                    hiDep := Maximum(Depth(rs[hi]), Depth(rs[lo]));
                    k := coll![PC_COMMUTE][loDep];
                    if k = loDep or k < hiDep then
                        ar := id;
                    else
                        ar := Comm(rs[hi], rs[lo]);
                    fi;
                fi;
                if al = id and ar = id then
                    # all future steps would be trivial
                    continue;
                fi;
                tm := [al, ar];
                if depth(tm) < c then
                    Add(todo, tm);
                    Add(val, value(tm));
                fi;
                if lo <= n then
                    g := ls[lo];
                else
                    g := rs[lo];
                fi;
                if RelativeOrderPcp(g) = 0 then
                    # if [ h, g ] = 1, then also [ h, g^-1 ] = 1
                    # so skip if [ h, g ] = 1 is known already
                    if al <> id then
                        al := Comm(ls[hi], IgsNegativePower(ls, lpows, lo, 1));
                    fi;
                    if ar <> id then
                        ar := Comm(rs[hi], IgsNegativePower(rs, rpows, lo, 1));
                    fi;
                    tm := [al, ar];
                    if depth(tm) < c then
                        Add(todo, tm);
                        Add(val, value(tm));
                    fi;
                fi;
            od;
        od;

        # reduce
        if c < oldc or not IsEmpty(chg) then
            sub := Filtered([1..Length(todo)], i -> depth(todo[i]) < c);
            todo := todo{sub};
            val := val{sub};
        fi;
    od;

    # return resulting subgroup
    I := Filtered(rs{[n+1..2*n]}, x -> x <> id);
    return SubgroupByIgs( N, I );
end );

#############################################################################
##
#F IntersectionPcpGroups( U, H )
##
## Based on Section 8.4 of "Algorithms for Polycyclic Groups" by B. Eick.
##
BindGlobal( "IntersectionPcpGroups", function( U, H )
    local G, ser, A, p, G_A, gensU, imgsU, paraU, UA_A, gensH, imgsH, paraH,
          HA_A, UA_HA_A, prei, U_HA, A_H, delta, K, pcpA, ords, free, tors,
          lifts, pcpK, mats, e, q, Q, act, oper, stab;

    # create parent group and abelian normal subgroup
    G := ClosureGroup( U, Igs( H ) );
    ser := EfaSeries( G );
    A := ser[ Length( ser ) - 1 ];
    p := NaturalHomomorphismByNormalSubgroupNC( G, A );
    G_A := ImagesSource( p );

    # calculate UA/A
    gensU := Igs( U );
    imgsU := List( gensU, x -> ImagesRepresentative( p, x ) );
    paraU := IgsParallel( imgsU, gensU );
    UA_A := SubgroupByIgs( G_A, paraU[1] );

    # calculate HA/A
    gensH := Igs( H );
    imgsH := List( gensH, x -> ImagesRepresentative( p, x ) );
    paraH := IgsParallel( imgsH, gensH );
    HA_A := SubgroupByIgs( G_A, paraH[1] );

    # calculate UA/A ∩ HA/A = (UA ∩ HA)/A (by induction)
    UA_HA_A := Intersection( UA_A, HA_A );

    # calculate U ∩ HA
    prei := List(
        Igs( UA_HA_A ),
        x -> MappedVector( ExponentsByIgs( paraU[1], x ), paraU[2] )
    );
    U_HA := SubgroupByIgs( U, Igs( NormalIntersection( A, U ) ), prei );

    if IsTrivial( U_HA ) then
        return U_HA;
    fi;

    A_H := NormalIntersection( A, H );
    if A_H = A then
        return U_HA;
    fi;

    # create derivation (minus projection to A/(A ∩ H))
    # code adapted from PreImagesRepresentativeNC for ToPcpGHBI
    delta := function( x )
        local exp, h;
        exp := ExponentsByIgs( paraH[1], ImagesRepresentative( p, x ) );
        if IsEmpty( exp ) then return x; fi;
        h := MappedVector( exp, paraH[2] );
        return h ^ -1 * x;
    end;

    # work inside A/(A ∩ H)
    K := U_HA;
    # avoid constructing A/(A ∩ H) explictily for now
    # use SNF (based on code by Max Mayer)
    if HirschLength( A ) > HirschLength( A_H ) then
        pcpA := Pcp( A, A_H, "snf" );
        ords := RelativeOrdersOfPcp( pcpA );
        free := Filtered( [ 1 .. Length( ords ) ], i -> ords[i] = 0 );
        tors := Filtered( [ 1 .. Length( ords ) ], i -> ords[i] <> 0 );
        lifts := pcpA{ free };
        pcpK := Pcp( K );
        # create matrices corresponding to affine action
        mats := List( pcpK, g -> Concatenation(
            List( lifts, a -> Concatenation(
                ExponentsByPcp( pcpA, a ^ g ){ free} , [0]
            ) ),
            [ Concatenation(
                ExponentsByPcp( pcpA, delta( g ) ){ free },
                [1]
            ) ]
        ) );
        e := Concatenation(
            ListWithIdenticalEntries( Length( free ), 0 ),
            [1]
        );
        # calculate stabiliser of affine action, replace K
        K := StabilizerIntegralAction( K, mats, e );
        if IsEmpty( tors ) or IsTrivial( K ) then
            return K;
        fi;
    fi;
    # construct Q := A/(A ∩ H)
    q := NaturalHomomorphismByNormalSubgroupNC( A, A_H );
    Q := ImagesSource( q );

    pcpK := Pcp( K );
    act := List( pcpK, g -> [ g, ImagesRepresentative( q, delta( g ) ) ] );
    oper := function( pnt, g )
        return ImagesRepresentative( q,
            PreImagesRepresentativeNC( q, pnt ) ^ g[1]
        ) * g[2];
    end;
    stab := PcpOrbitStabilizer( One( Q ), pcpK, act, oper );
    return SubgroupByIgs( K, stab.stab );
end );

#############################################################################
##
#M Intersection( U, V )
##
InstallMethod( Intersection2, "for pcp groups",
               IsIdenticalObj, [IsPcpGroup, IsPcpGroup],
function( U, V )
    # check for trivial cases
    if IsInt(Size(U)) and IsInt(Size(V)) then
        if IsInt(Size(V)/Size(U)) and ForAll(Igs(U), x -> x in V ) then
            return U;
        elif Size(V)<Size(U) and IsInt(Size(U)/Size(V))
             and ForAll( Igs(V), x -> x in U ) then
            return V;
        fi;
    fi;

    # test if one the groups is known to be normal
    if IsNormal( V, U ) then
        return NormalIntersection( U, V );
    elif IsNormal( U, V ) then
        return NormalIntersection( V, U );
    fi;

    return IntersectionPcpGroups( U, V );
end );
